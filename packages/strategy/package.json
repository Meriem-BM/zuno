{
  "name": "@zuno/strategy",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./intents": "./src/intents/index.ts",
    "./planner": "./src/planner/index.ts",
    "./axl": "./src/axl/index.ts",
    "./agents": "./src/agents/index.ts"
  },
  "scripts": {
    "start:watcher": "tsx src/agents/watcher/index.ts",
    "start:planner": "tsx src/agents/planner/index.ts",
    "start:risk": "tsx src/agents/risk/index.ts",
    "start:monitor": "tsx src/agents/monitor/index.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:intents": "tsx --test tests/intents/*.test.ts",
    "test:planner": "tsx --test tests/planner/*.test.ts",
    "test:axl": "tsx --test tests/axl/*.test.ts",
    "test:monitor": "tsx --test tests/monitor/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zuno/chain": "workspace:*",
    "@zuno/core": "workspace:*",
    "@zuno/storage": "workspace:*",
    "openai": "^4.70.0",
    "viem": "^2.48.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
