# OpenAI API key
OPENAI_API_KEY=

# AXL daemon base URL point at a real Gensyn AXL node, or leave unset to
# use the bundled mock relay started by `pnpm axl:mock`.
# Default: http://localhost:9100
# ZUNO_AXL_URL=http://localhost:9100

# Port for the bundled AXL mock relay (default : 9100)
# ZUNO_AXL_PORT=9100
