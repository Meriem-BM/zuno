# Chain. 1 mainnet, 10 optimism, 8453 base, 42161 arbitrum.
ZUNO_CHAIN_ID=42161

# Per-chain RPC URLs. Optional; viem falls back to public RPCs.
ZUNO_MAINNET_RPC_URL=
ZUNO_OPTIMISM_RPC_URL=
ZUNO_BASE_RPC_URL=
ZUNO_ARBITRUM_RPC_URL=

# Persistence directories. Plans default to ~/.zuno/plans, alerts to
# ~/.zuno/alerts.json, prepared actions to ~/.zuno/actions.
# Monitor interval must be >= 5000ms.
ZUNO_PLAN_DIR=
ZUNO_ALERT_DIR=
ZUNO_ACTION_DIR=
ZUNO_MONITOR_INTERVAL_MS=60000

# Auth proxy URL. Set this when consuming a hosted Zuno auth proxy
# (apps/proxy) — the CLI will route initOtp/verifyOtp/otpLogin through
# the proxy instead of calling Turnkey directly. The published `zuno`
# CLI bakes a default proxy URL in at build time; self-hosters either
# point it at their own proxy or unset it and use the parent-org creds
# below to talk to Turnkey directly.
ZUNO_AUTH_PROXY_URL=

# Publish-time CLI build setting. Used by `pnpm --filter @zuno/cli build`
# to bake a default auth proxy URL into the npm-published `zuno` binary.
# Runtime ZUNO_AUTH_PROXY_URL still overrides this for self-hosting.
ZUNO_PUBLIC_PROXY_URL=

# Local auth proxy server. `PORT` is only used by apps/proxy when running
# locally with Node. `ZUNO_ALLOWED_CLIENTS` is used by the Worker binding
# shape and is intended for hosted proxy client-version gates.
PORT=8787
ZUNO_ALLOWED_CLIENTS=0.

# Parent-org Turnkey credentials. Used only when ZUNO_AUTH_PROXY_URL is
# unset — i.e. the local-dev / self-host path that talks to Turnkey
# directly. Proxy users do NOT need these. After sign-in, every wallet
# operation goes through the user's own session keys (held in
# ~/.zuno/session.json, 0600, 1h TTL) — Turnkey's architecture
# guarantees the parent org has read-only access to sub-org wallets.
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# Optional override for where the user session is persisted.
# Default: ~/.zuno/session.json
ZUNO_SESSION_PATH=

# Wallet address override for the background monitor process. The CLI
# reads this from the active session — set this only if you want to
# point the monitor at a wallet without going through the CLI sign-in.
ZUNO_AGENT_WALLET_ADDRESS=

# Optional Telegram alert delivery for the local monitor worker.
# Create a bot with BotFather, send it a message once, then set the
# chat id. When unset, the monitor still writes local alerts only.
ZUNO_TELEGRAM_BOT_TOKEN=
ZUNO_TELEGRAM_CHAT_ID=
ZUNO_TELEGRAM_API_BASE_URL=https://api.telegram.org

# AXL nodes. Each role runs its own Gensyn AXL node — generate keys and
# config with `bash tooling/axl-bootstrap.sh`, then run a real `node`
# binary against each generated config in its own terminal.
ZUNO_AXL_CLI_API_URL=http://127.0.0.1:9002
ZUNO_AXL_WATCHER_API_URL=http://127.0.0.1:9012
ZUNO_AXL_PLANNER_API_URL=http://127.0.0.1:9022
ZUNO_AXL_RISK_API_URL=http://127.0.0.1:9032
ZUNO_AXL_CLI_PEER_ID=
ZUNO_AXL_WATCHER_PEER_ID=
ZUNO_AXL_PLANNER_PEER_ID=
ZUNO_AXL_RISK_PEER_ID=

# Intent fallback. Deterministic parsing runs first; the model only
# routes low-confidence natural language. Providers: openai, groq.
ZUNO_INTENT_PROVIDER=openai
ZUNO_INTENT_MODEL=gpt-5-nano
OPENAI_API_KEY=
GROQ_API_KEY=
ZUNO_DEBUG_INTENTS=false

# Apply hook. Optional dev escape hatch for testing apply with fixed calldata.
# Normal execution builds deterministic Uniswap rebalance calldata.
ZUNO_UNISWAP_REBALANCE_CALLDATA=
