# Intent fallback. Deterministic parsing runs first; the model is only used
# for low-confidence natural language routing.
# Supported providers: openai, groq
# ZUNO_INTENT_PROVIDER=openai
# OPENAI_API_KEY=
# ZUNO_INTENT_MODEL=gpt-5-nano
#
# Cheap hosted fallback:
# ZUNO_INTENT_PROVIDER=groq
# GROQ_API_KEY=
# ZUNO_INTENT_MODEL=llama-3.1-8b-instant
#
# ZUNO_DEBUG_INTENTS=false

# Read-only watch target. Zuno never needs a wallet connection for reads.
# You can also paste an address directly in the CLI.
# ZUNO_WATCH_ADDRESS=0x0000000000000000000000000000000000000000
# Legacy alias, still accepted:
# ZUNO_WALLET_ADDRESS=

# Supported chains: 1 mainnet, 10 optimism, 8453 base, 42161 arbitrum.
# Default: 42161
# ZUNO_CHAIN_ID=42161

# RPC URLs. If omitted, viem falls back to the chain's public RPC endpoints.
# ZUNO_MAINNET_RPC_URL=
# ZUNO_OPTIMISM_RPC_URL=
# ZUNO_BASE_RPC_URL=
# ZUNO_ARBITRUM_RPC_URL=

# Plan persistence directory. Default: ~/.zuno/plans
# ZUNO_PLAN_DIR=

# Alert persistence directory and monitor interval. Alerts default to
# ~/.zuno/alerts.json. The monitor interval must be at least 5000ms.
# ZUNO_ALERT_DIR=
# ZUNO_MONITOR_INTERVAL_MS=60000

# AXL daemon base URL and peer ids. Default: http://localhost:9002
# ZUNO_AXL_URL=http://localhost:9002
# ZUNO_AXL_CLI_PEER_ID=
# ZUNO_AXL_WATCHER_PEER_ID=
# ZUNO_AXL_PLANNER_PEER_ID=
# ZUNO_AXL_RISK_PEER_ID=

# QR execution approval. Required only when applying a plan.
# REOWN_PROJECT_ID=
# Optional local integration hook if a WalletConnect URI is created externally.
# ZUNO_WALLETCONNECT_URI=
