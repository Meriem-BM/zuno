# Chain. 1, 10, 8453, 42161, 11155111, 84532, 421614, 1301.
ZUNO_CHAIN_ID=42161

# Per-chain RPC URLs. Optional; viem falls back to public RPCs.
ZUNO_MAINNET_RPC_URL=
ZUNO_OPTIMISM_RPC_URL=
ZUNO_BASE_RPC_URL=
ZUNO_ARBITRUM_RPC_URL=
ZUNO_SEPOLIA_RPC_URL=
ZUNO_BASE_SEPOLIA_RPC_URL=
ZUNO_ARBITRUM_SEPOLIA_RPC_URL=
ZUNO_UNICHAIN_SEPOLIA_RPC_URL=

# Uniswap Trading API. Required for executable standalone swaps.
ZUNO_UNISWAP_TRADING_API_BASE_URL=https://trade-api.gateway.uniswap.org/v1
ZUNO_UNISWAP_TRADING_API_KEY=

# Persistence dirs (default ~/.zuno/{plans,alerts.json,actions}). Monitor interval >= 5000ms.
ZUNO_PLAN_DIR=
ZUNO_ALERT_DIR=
ZUNO_ACTION_DIR=
ZUNO_MONITOR_INTERVAL_MS=60000

# Auth proxy. Routes OTP through apps/proxy instead of Turnkey directly.
ZUNO_AUTH_PROXY_URL=

# Build-time default proxy URL baked into the published CLI.
ZUNO_PUBLIC_PROXY_URL=

# Local apps/proxy port.
PORT=8787

# Parent-org Turnkey creds. Only needed when ZUNO_AUTH_PROXY_URL is unset.
TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# Override session path. Default ~/.zuno/session.json.
ZUNO_SESSION_PATH=

# Override the wallet the monitor watches (otherwise reads from session).
ZUNO_AGENT_WALLET_ADDRESS=

# Telegram alerts. Falls back to local alerts file when unset.
ZUNO_TELEGRAM_BOT_TOKEN=
ZUNO_TELEGRAM_CHAT_ID=
ZUNO_TELEGRAM_API_BASE_URL=https://api.telegram.org

# AXL mesh. Generate keys with `bash tooling/axl-bootstrap.sh`.
ZUNO_AXL_CLI_API_URL=http://127.0.0.1:9002
ZUNO_AXL_SCOUT_API_URL=http://127.0.0.1:9012
ZUNO_AXL_STRATEGIST_API_URL=http://127.0.0.1:9022
ZUNO_AXL_CRITIC_API_URL=http://127.0.0.1:9032
ZUNO_AXL_ARBITER_API_URL=http://127.0.0.1:9042
ZUNO_AXL_CLI_PEER_ID=
ZUNO_AXL_SCOUT_PEER_ID=
ZUNO_AXL_STRATEGIST_PEER_ID=
ZUNO_AXL_CRITIC_PEER_ID=
ZUNO_AXL_ARBITER_PEER_ID=

# Max strategist/critic rounds before arbiter fires.
ZUNO_MAX_DEBATE_ROUNDS=2

# conservative | balanced | aggressive.
ZUNO_RISK_PROFILE=balanced

# Skip LLM agents, use deterministic recommendPlan.
ZUNO_DETERMINISTIC=false

# Pool-discovery cache dir. Default ~/.zuno, 30-min TTL.
ZUNO_POOL_CACHE_DIR=

# Agent model. Any model supporting OpenAI structured outputs.
ZUNO_AGENT_MODEL=gpt-4o-mini

# Intent fallback. Providers: openai, groq.
ZUNO_INTENT_PROVIDER=openai
ZUNO_INTENT_MODEL=gpt-5-nano
OPENAI_API_KEY=
GROQ_API_KEY=
ZUNO_DEBUG_INTENTS=false

# Dev escape hatch: fixed calldata for apply.
ZUNO_UNISWAP_REBALANCE_CALLDATA=
