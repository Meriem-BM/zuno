{
  "name": "zuno",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently --kill-others --names web,docs --prefix-colors magenta,cyan \"pnpm web\" \"pnpm docs:dev\"",
    "mesh": "concurrently --kill-others --names watcher,planner,risk --prefix-colors yellow,blue,red \"pnpm watcher\" \"pnpm planner\" \"pnpm risk\"",
    "web": "pnpm --filter @zuno/web dev",
    "docs:dev": "pnpm --filter @zuno/docs dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "cli": "pnpm --filter @zuno/cli start",
    "watcher": "pnpm --filter @zuno/strategy start:watcher",
    "planner": "pnpm --filter @zuno/strategy start:planner",
    "risk": "pnpm --filter @zuno/strategy start:risk",
    "monitor": "pnpm --filter @zuno/strategy start:monitor",
    "test:intents": "pnpm --filter @zuno/strategy test:intents",
    "test:runtime": "pnpm --filter @zuno/runtime test",
    "test:cli": "pnpm --filter @zuno/cli test",
    "test:wallet": "pnpm --filter @zuno/chain test:wallet",
    "test:uniswap": "pnpm --filter @zuno/chain test:uniswap",
    "test:planner": "pnpm --filter @zuno/strategy test:planner",
    "test:execution": "pnpm --filter @zuno/execution test",
    "test:storage": "pnpm --filter @zuno/storage test",
    "test:axl": "pnpm --filter @zuno/strategy test:axl",
    "test:monitor": "pnpm --filter @zuno/strategy test:monitor",
    "test:tokens": "pnpm --filter @zuno/chain test:tokens",
    "test": "pnpm test:intents && pnpm test:wallet && pnpm test:tokens && pnpm test:uniswap && pnpm test:planner && pnpm test:storage && pnpm test:execution && pnpm test:axl && pnpm test:monitor && pnpm test:runtime && pnpm test:cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.1"
  }
}
