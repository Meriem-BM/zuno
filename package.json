{
  "name": "zuno",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently --kill-others --names web,docs,watcher,planner,risk --prefix-colors magenta,cyan,yellow,blue,red \"pnpm web\" \"pnpm docs:dev\" \"pnpm watcher\" \"pnpm planner\" \"pnpm risk\"",
    "web": "pnpm --filter @zuno/web dev",
    "docs:dev": "pnpm --filter @zuno/docs dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "cli": "pnpm --filter @zuno/cli start",
    "watcher": "pnpm --filter @zuno/agents start:watcher",
    "planner": "pnpm --filter @zuno/agents start:planner",
    "risk": "pnpm --filter @zuno/agents start:risk",
    "monitor": "pnpm --filter @zuno/agents start:monitor",
    "test:intents": "pnpm --filter @zuno/intents test",
    "test:runtime": "pnpm --filter @zuno/runtime test",
    "test:cli": "pnpm --filter @zuno/cli test",
    "test:wallet": "pnpm --filter @zuno/wallet test",
    "test:uniswap": "pnpm --filter @zuno/uniswap test",
    "test:planner": "pnpm --filter @zuno/planner test",
    "test:execution": "pnpm --filter @zuno/execution test",
    "test:storage": "pnpm --filter @zuno/storage test",
    "test:axl": "pnpm --filter @zuno/axl test",
    "test": "pnpm test:intents && pnpm test:wallet && pnpm test:uniswap && pnpm test:planner && pnpm test:storage && pnpm test:execution && pnpm test:axl && pnpm test:runtime && pnpm test:cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.1"
  }
}
